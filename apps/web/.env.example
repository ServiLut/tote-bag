# Public app URL used by metadata/canonical URL generation.
# In production this must be https and must not point to localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Public API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4003/api/v1

# Public Supabase settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Optional extra image allowlist for next/image remote patterns.
# Comma-separated hostnames only. Supabase host is inferred from NEXT_PUBLIC_SUPABASE_URL.
NEXT_IMAGE_REMOTE_HOSTS=your-project.supabase.co

# Optional custom Next.js build output directory.
NEXT_DIST_DIR=.next
