generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["tote-bag"]
}

model Product {
  id                      String                   @id @default(uuid()) @map("id")
  name                    String                   @map("name")
  description             String                   @map("description")
  basePrice               Decimal                  @map("base_price") @db.Decimal(10, 2)
  minPrice                Decimal                  @map("min_price") @db.Decimal(10, 2)
  comparePrice            Decimal?                 @map("compare_price") @db.Decimal(10, 2)
  costPrice               Decimal?                 @map("cost_price") @db.Decimal(10, 2)
  status                  ProductStatus            @default(BAJO_PEDIDO) @map("status")
  collectionId            String                   @map("collection_id")
  slug                    String                   @unique @map("slug")
  seoTitle                String?                  @map("seo_title")
  seoDescription          String?                  @map("seo_description")
  tags                    String[]                 @default([]) @map("tags")
  deliveryTime            String                   @map("delivery_time")
  material                String                   @default("Algodón resistente") @map("material")
  dimensions              String?                  @map("dimensions")
  careInstructions        String?                  @map("care_instructions")
  printType               PrintType                @default(DTF) @map("print_type")
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  quoteItems              B2BQuoteItem[]
  orderItems              OrderItem[]
  personalizationRequests PersonalizationRequest[]
  personalizationRules    PersonalizationRule[]
  pricingRules            PricingRule[]
  attributes              ProductAttribute[]
  images                  ProductImage[]
  collection              Collection               @relation(fields: [collectionId], references: [id])
  purchaseBatches         PurchaseBatch[]
  variants                Variant[]

  @@map("products")
  @@schema("tote-bag")
}

model ProductImage {
  id        String  @id @default(uuid()) @map("id")
  url       String  @map("url")
  alt       String? @map("alt")
  position  Int     @default(0) @map("position")
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
  @@schema("tote-bag")
}

model Collection {
  id        String    @id @default(uuid()) @map("id")
  name      String    @map("name")
  slug      String    @unique @map("slug")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("collections")
  @@schema("tote-bag")
}

model Variant {
  id                      String                   @id @default(uuid()) @map("id")
  sku                     String                   @unique @map("sku")
  size                    String?                  @map("size")
  color                   String                   @map("color")
  imageUrl                String                   @map("image_url")
  salePrice               Decimal?                 @map("sale_price") @db.Decimal(10, 2)
  minPrice                Decimal?                 @map("min_price") @db.Decimal(10, 2)
  comparePrice            Decimal?                 @map("compare_price") @db.Decimal(10, 2)
  costPrice               Decimal?                 @map("cost_price") @db.Decimal(10, 2)
  totalCost               Decimal?                 @map("total_cost") @db.Decimal(10, 2)
  taxRate                 Decimal                  @default(0.19) @map("tax_rate") @db.Decimal(4, 2)
  stock                   Int                      @default(0) @map("stock")
  stockCommitted          Int                      @default(0) @map("stock_committed")
  reorderPoint            Int?                     @map("reorder_point")
  isActive                Boolean                  @default(true) @map("is_active")
  productId               String                   @map("product_id")
  inventoryAdjustments    InventoryAdjustment[]
  inventoryMovements      InventoryMovement[]
  nonCommercialOutputs    NonCommercialInventoryOutput[]
  b2BQuoteItems           B2BQuoteItem[]
  orderItems              OrderItem[]
  personalizationRequests PersonalizationRequest[]
  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseBatches         PurchaseBatch[]
  purchaseBatchLines      PurchaseBatchLine[]

  @@index([productId, size])
  @@index([productId, isActive])
  @@map("variants")
  @@schema("tote-bag")
}

model Order {
  id                String               @id @default(uuid()) @map("id")
  orderNumber       Int                  @unique @default(autoincrement()) @map("order_number")
  customerEmail     String               @map("customer_email")
  customerPhone     String               @map("customer_phone")
  shippingAddress   Json                 @map("shipping_address")
  shippingMethod    ShippingMethod       @default(SHIPPING) @map("shipping_method")
  shippingCost      Decimal              @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  city              String               @map("city")
  totalAmount       Decimal              @map("total_amount") @db.Decimal(10, 2)
  netAmount         Decimal              @map("net_amount") @db.Decimal(10, 2)
  taxTotal          Decimal              @map("tax_total") @db.Decimal(10, 2)
  amountPaid        Decimal              @default(0) @map("amount_paid") @db.Decimal(18, 2)
  balanceDue        Decimal              @default(0) @map("balance_due") @db.Decimal(18, 2)
  currency          String               @default("COP") @map("currency")
  status            OrderStatus          @default(PENDIENTE_PAGO) @map("status")
  source            OrderSource          @default(ECOMMERCE) @map("source")
  trackingNumber    String?              @map("tracking_number")
  carrier           String?              @map("carrier")
  isB2B             Boolean              @default(false) @map("is_b2b")
  isManual          Boolean              @default(false) @map("is_manual")
  paymentReceiptUrl String?              @map("payment_receipt_url")
  saleLegalRequirement SaleLegalRequirement @default(PENDING_STOCK_ASSIGNMENT) @map("sale_legal_requirement")
  saleLegalStatus   SaleLegalStatus      @default(PENDING) @map("sale_legal_status")
  saleLegalDocumentType SaleLegalDocumentType? @map("sale_legal_document_type")
  saleLegalDocumentReference String?     @map("sale_legal_document_reference")
  saleLegalTrace    Json?                @map("sale_legal_trace")
  saleLegalResolvedAt DateTime?          @map("sale_legal_resolved_at")
  saleLegalCompletedAt DateTime?         @map("sale_legal_completed_at")
  deletedAt         DateTime?            @map("deleted_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  profileId         String?              @map("profile_id")
  items             OrderItem[]
  payments          OrderPayment[]
  idempotencyRecord OrderIdempotencyKey?
  inventoryMovements InventoryMovement[]
  statusHistory     OrderStatusHistory[]
  profile           Profile?             @relation(fields: [profileId], references: [id])
  shipment          Shipment?

  @@map("orders")
  @@schema("tote-bag")
}

model ShippingProvider {
  id        String     @id @default(uuid()) @map("id")
  name      String     @map("name")
  contact   String?    @map("contact")
  apiKey    String?    @map("api_key")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  shipments Shipment[]

  @@map("shipping_providers")
  @@schema("tote-bag")
}

model Shipment {
  id                String                @id @default(uuid()) @map("id")
  orderId           String                @unique @map("order_id")
  providerId        String?               @map("provider_id")
  trackingNumber    String?               @map("tracking_number")
  status            ShipmentStatus        @default(PENDING) @map("status")
  weight            Decimal?              @map("weight") @db.Decimal(10, 3)
  dimensions        String?               @map("dimensions")
  estimatedDelivery DateTime?             @map("estimated_delivery")
  shippedAt         DateTime?             @map("shipped_at")
  deliveredAt       DateTime?             @map("delivered_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  order             Order                 @relation(fields: [orderId], references: [id])
  provider          ShippingProvider?     @relation(fields: [providerId], references: [id])
  supplyUsages      ShipmentSupplyUsage[]

  @@map("shipments")
  @@schema("tote-bag")
}

model OrderStatusHistory {
  id        String       @id @default(uuid()) @map("id")
  orderId   String       @map("order_id")
  status    OrderStatus  @map("status")
  oldStatus OrderStatus? @map("old_status")
  newStatus OrderStatus? @map("new_status")
  userId    String?      @map("user_id")
  createdAt DateTime     @default(now()) @map("created_at")
  order     Order        @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
  @@schema("tote-bag")
}

model OrderIdempotencyKey {
  id             String   @id @default(uuid()) @map("id")
  idempotencyKey String   @unique @map("idempotency_key")
  requestHash    String?  @map("request_hash")
  orderId        String?  @unique @map("order_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("order_idempotency_keys")
  @@schema("tote-bag")
}

model OrderPayment {
  id                   String    @id @default(uuid()) @map("id")
  orderId              String    @map("order_id")
  amount               Decimal   @map("amount") @db.Decimal(18, 2)
  paymentDate          DateTime  @map("payment_date")
  proofUrl             String    @map("proof_url")
  notes                String?   @map("notes")
  provider             String?   @map("provider")
  externalTransactionId String?  @map("external_transaction_id")
  externalStatus       String?   @map("external_status")
  paymentMethodType    String?   @map("payment_method_type")
  grossAmount          Decimal?  @map("gross_amount") @db.Decimal(18, 2)
  netReceivedAmount    Decimal?  @map("net_received_amount") @db.Decimal(18, 2)
  commissionAmount     Decimal?  @map("commission_amount") @db.Decimal(18, 2)
  commissionVatAmount  Decimal?  @map("commission_vat_amount") @db.Decimal(18, 2)
  reteFuenteAmount     Decimal?  @map("rete_fuente_amount") @db.Decimal(18, 2)
  reteIvaAmount        Decimal?  @map("rete_iva_amount") @db.Decimal(18, 2)
  reteIcaAmount        Decimal?  @map("rete_ica_amount") @db.Decimal(18, 2)
  packagingCifAmount   Decimal?  @map("packaging_cif_amount") @db.Decimal(18, 2)
  settlementSource     String?   @map("settlement_source")
  settlementMetadata   Json?     @map("settlement_metadata")
  reconciledAt         DateTime? @map("reconciled_at")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, paymentDate])
  @@index([provider])
  @@index([externalTransactionId])
  @@map("order_payments")
  @@schema("tote-bag")
}

model OrderItem {
  id                String   @id @default(uuid()) @map("id")
  quantity          Int      @map("quantity")
  totalPrice        Decimal  @default(0) @map("total_price") @db.Decimal(10, 2)
  sku               String   @map("sku")
  imageUrl          String?  @map("image_url")
  configurationJson Json?    @map("configuration_json")
  pricingJson       Json?    @map("pricing_json")
  orderId           String   @map("order_id")
  productId         String   @map("product_id")
  variantId         String?  @map("variant_id")
  unitPrice         Decimal  @default(0) @map("unit_price") @db.Decimal(10, 2)
  netUnitPrice      Decimal  @map("net_unit_price") @db.Decimal(10, 2)
  /// IVA total de la linea, calculado como total bruto de linea menos total neto de linea.
  taxAmount         Decimal  @map("tax_amount") @db.Decimal(10, 2)
  order             Order    @relation(fields: [orderId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])
  variant           Variant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
  @@schema("tote-bag")
}

model User {
  id                              String                   @id @map("id")
  email                           String                   @unique @map("email")
  role                            Role                     @default(CUSTOMER) @map("role")
  isActive                        Boolean                  @default(true) @map("is_active")
  createdAt                       DateTime                 @default(now()) @map("created_at")
  updatedAt                       DateTime                 @updatedAt @map("updated_at")
  auditLogs                       AuditLog[]
  financialTransactions           FinancialTransaction[]
  inventoryAdjustments            InventoryAdjustment[]
  inventoryMovements              InventoryMovement[]
  nonCommercialInventoryOutputs   NonCommercialInventoryOutput[]
  profile                         Profile?
  personalizationRequests         PersonalizationRequest[] @relation("PersonalizationRequestUser")
  reviewedPersonalizationRequests PersonalizationRequest[] @relation("PersonalizationRequestReviewedBy")
  knowledgePosts                  KnowledgePost[]
  roles                           UserRole[]
  managerApprovalsRequested       ManagerApproval[]       @relation("ManagerApprovalRequestedBy")
  managerApprovalsApproved        ManagerApproval[]       @relation("ManagerApprovalApprovedBy")
  managerApprovalsUsed            ManagerApproval[]       @relation("ManagerApprovalUsedBy")

  @@map("users")
  @@schema("tote-bag")
}

model RoleModel {
  id          String           @id @default(uuid()) @map("id")
  name        String           @unique @map("name")
  description String?          @map("description")
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
  @@schema("tote-bag")
}

model Permission {
  id          String           @id @default(uuid()) @map("id")
  resource    String           @map("resource")
  action      String           @map("action")
  description String?          @map("description")
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("tote-bag")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         RoleModel  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("tote-bag")
}

model UserRole {
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String?   @map("assigned_by")
  role       RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("tote-bag")
}

model WebhookEvent {
  id                String                  @id @default(uuid()) @map("id")
  provider          String                  @map("provider")
  eventId           String                  @unique @map("event_id")
  eventType         String                  @map("event_type")
  payload           Json                    @map("payload")
  processed         Boolean                 @default(false) @map("processed")
  processedAt       DateTime?               @map("processed_at")
  error             String?                 @map("error")
  status            WebhookProcessingStatus @default(RECEIVED) @map("status")
  attempts          Int                     @default(0) @map("attempts")
  signatureChecksum String?                 @map("signature_checksum")
  transactionId     String?                 @map("transaction_id")
  referenceId       String?                 @map("reference_id")
  receivedAt        DateTime                @default(now()) @map("received_at")
  validatedAt       DateTime?               @map("validated_at")
  appliedAt         DateTime?               @map("applied_at")
  failedAt          DateTime?               @map("failed_at")
  createdAt         DateTime                @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
  @@schema("tote-bag")
}

model PqrsTicket {
  id            String     @id @default(uuid()) @map("id")
  fullName      String     @map("full_name")
  email         String     @map("email")
  phone         String?    @map("phone")
  type          PqrsType   @map("type")
  subject       String     @map("subject")
  message       String     @map("message")
  orderNumber   String?    @map("order_number")
  status        PqrsStatus @default(NUEVO) @map("status")
  adminResponse String?    @map("admin_response")
  resolvedAt    DateTime?  @map("resolved_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@map("pqrs_tickets")
  @@schema("tote-bag")
}

model Profile {
  id                      String                   @id @default(uuid()) @map("id")
  email                   String                   @unique @map("email")
  firstName               String?                  @map("first_name")
  lastName                String?                  @map("last_name")
  phone                   String?                  @map("phone")
  department              String?                  @map("department")
  municipality            String?                  @map("municipality")
  neighborhood            String?                  @map("neighborhood")
  address                 String?                  @map("address")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  userId                  String                   @unique @map("user_id")
  metadata                Json?                    @map("metadata")
  departmentId            String?                  @map("department_id")
  municipalityId          String?                  @map("municipality_id")
  dataPolicyAccepted      Boolean                  @default(false) @map("data_policy_accepted")
  dataPolicyAcceptedAt    DateTime?                @map("data_policy_accepted_at")
  dataPolicyAcceptedIp    String?                  @map("data_policy_accepted_ip")
  addresses               Address[]
  orders                  Order[]
  personalizationRequests PersonalizationRequest[]
  locationDepartment      Department?              @relation(fields: [departmentId], references: [id])
  locationMunicipality    Municipality?            @relation(fields: [municipalityId], references: [id])
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
  @@schema("tote-bag")
}

model Department {
  id             String         @id @default(uuid()) @map("id")
  name           String         @unique @map("name")
  code           String?        @unique @map("code")
  addresses      Address[]
  municipalities Municipality[]
  profiles       Profile[]

  @@map("departments")
  @@schema("tote-bag")
}

model Municipality {
  id           String     @id @default(uuid()) @map("id")
  name         String     @map("name")
  code         String?    @map("code")
  departmentId String     @map("department_id")
  addresses    Address[]
  department   Department @relation(fields: [departmentId], references: [id])
  profiles     Profile[]

  @@unique([departmentId, name])
  @@map("municipalities")
  @@schema("tote-bag")
}

model B2BQuote {
  id                String         @id @default(uuid()) @map("id")
  businessName      String         @map("business_name")
  quantity          Int            @map("quantity")
  department        String         @map("department")
  municipality      String         @map("municipality")
  neighborhood      String         @map("neighborhood")
  address           String         @map("address")
  contactPhone      String         @map("contact_phone")
  qrType            String         @map("qr_type")
  qrData            String?        @map("qr_data")
  logoUrl           String?        @map("logo_url")
  package           String         @map("package")
  status            String         @default("PENDIENTE") @map("status")
  paymentReceiptUrl String?        @map("payment_receipt_url")
  expiresAt         DateTime?      @map("expires_at")
  reservationStatus B2BReservationStatus @default(NONE) @map("reservation_status")
  reservationHours  Int?           @map("reservation_hours")
  reservationReleasedAt DateTime?  @map("reservation_released_at")
  deletedAt         DateTime?      @map("deleted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  material          String?        @map("material")
  size              String?        @map("size")
  items             B2BQuoteItem[]

  @@map("b2b_quotes")
  @@schema("tote-bag")
}

model AuditLog {
  id           String   @id @default(uuid()) @map("id")
  action       String   @map("action")
  entity       String   @map("entity")
  entityId     String?  @map("entity_id")
  payload      Json?    @map("payload")
  newData      Json?    @map("new_data")
  userId       String?  @map("user_id")
  ip           String?  @map("ip")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  previousData Json?    @map("previous_data")
  user         User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@schema("tote-bag")
}

model Address {
  id             String       @id @default(uuid()) @map("id")
  profileId      String       @map("profile_id")
  title          String       @map("title")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  phone          String       @map("phone")
  departmentId   String       @map("department_id")
  municipalityId String       @map("municipality_id")
  address        String       @map("address")
  neighborhood   String?      @map("neighborhood")
  additionalInfo String?      @map("additional_info")
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  department     Department   @relation(fields: [departmentId], references: [id])
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("addresses")
  @@schema("tote-bag")
}

model ProductAttribute {
  id            String        @id @default(uuid()) @map("id")
  productId     String        @map("product_id")
  type          AttributeType @map("type")
  priceModifier Decimal       @default(0) @map("price_modifier") @db.Decimal(10, 2)
  isActive      Boolean       @default(true) @map("is_active")
  deletedAt     DateTime?     @map("deleted_at")
  sortOrder     Int           @default(0) @map("sort_order")
  value         String        @default("") @map("value")
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@map("product_attributes")
  @@schema("tote-bag")
}

model PersonalizationOption {
  id                    String                @id @default(uuid()) @map("id")
  name                  String                @map("name")
  code                  String                @unique @map("code")
  basePrice             Decimal               @map("base_price") @db.Decimal(10, 2)
  description           String?               @map("description")
  isActive              Boolean               @default(true) @map("is_active")
  deletedAt             DateTime?             @map("deleted_at")
  allowedMaterialValues String[]              @default([]) @map("allowed_material_values")
  rules                 PersonalizationRule[]

  @@map("personalization_options")
  @@schema("tote-bag")
}

model PersonalizationRule {
  id                    String                @id @default(uuid()) @map("id")
  productId             String                @map("product_id")
  personalizationId     String                @map("personalization_id")
  allowedSizeValues     String[]              @map("allowed_size_values")
  allowedQualityValues  String[]              @map("allowed_quality_values")
  allowedMaterialValues String[]              @map("allowed_material_values")
  extraPrice            Decimal               @default(0) @map("extra_price") @db.Decimal(10, 2)
  extraDays             Int                   @default(0) @map("extra_days")
  isActive              Boolean               @default(true) @map("is_active")
  deletedAt             DateTime?             @map("deleted_at")
  personalization       PersonalizationOption @relation(fields: [personalizationId], references: [id], onDelete: Cascade)
  product               Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([personalizationId])
  @@map("personalization_rules")
  @@schema("tote-bag")
}

model PersonalizationRequest {
  id                String                       @id @default(uuid()) @map("id")
  userId            String                       @map("user_id")
  profileId         String?                      @map("profile_id")
  productId         String                       @map("product_id")
  variantId         String?                      @map("variant_id")
  quantity          Int                          @map("quantity")
  line              String                       @map("line")
  size              String                       @map("size")
  material          String                       @map("material")
  quality           String?                      @map("quality")
  configCode        String                       @map("config_code")
  unitPrice         Decimal                      @map("unit_price") @db.Decimal(10, 2)
  totalPrice        Decimal                      @map("total_price") @db.Decimal(10, 2)
  currency          String                       @default("COP") @map("currency")
  status            PersonalizationRequestStatus @default(PENDING) @map("status")
  notes             String?                      @map("notes")
  reviewNotes       String?                      @map("review_notes")
  reviewedAt        DateTime?                    @map("reviewed_at")
  reviewedByUserId  String?                      @map("reviewed_by_user_id")
  designUrl         String?                      @map("design_url")
  personalizations  Json                         @map("personalizations")
  configurationJson Json                         @map("configuration_json")
  pricingJson       Json?                        @map("pricing_json")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
