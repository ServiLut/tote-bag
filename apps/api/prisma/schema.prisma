generator client {
  provider        = "prisma-client"
  output          = "../src/generated/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["tote-bag"]
}

model Product {
  id                   String                @id @default(uuid()) @map("id")
  name                 String                @map("name")
  description          String                @map("description")
  basePrice            Float                 @map("base_price")
  minPrice             Float                 @map("min_price")
  comparePrice         Float?                @map("compare_price")
  costPrice            Float?                @map("cost_price")
  status               ProductStatus         @default(BAJO_PEDIDO) @map("status")
  collectionId         String                @map("collection_id")
  slug                 String                @unique @map("slug")
  seoTitle             String?               @map("seo_title")
  seoDescription       String?               @map("seo_description")
  tags                 String[]              @default([]) @map("tags")
  deliveryTime         String                @map("delivery_time")
  material             String                @default("Algodón resistente") @map("material")
  dimensions           String?               @map("dimensions")
  careInstructions     String?               @map("care_instructions")
  printType            PrintType             @default(DTF) @map("print_type")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  quoteItems           B2BQuoteItem[]
  orderItems           OrderItem[]
  personalizationRules PersonalizationRule[]
  pricingRules         PricingRule[]
  attributes           ProductAttribute[]
  images               ProductImage[]
  collection           Collection            @relation(fields: [collectionId], references: [id])
  variants             Variant[]
  purchaseBatches      PurchaseBatch[]

  @@map("products")
  @@schema("tote-bag")
}

model ProductImage {
  id        String  @id @default(uuid()) @map("id")
  url       String  @map("url")
  alt       String? @map("alt")
  position  Int     @default(0) @map("position")
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
  @@schema("tote-bag")
}

model Collection {
  id        String    @id @default(uuid()) @map("id")
  name      String    @map("name")
  slug      String    @unique @map("slug")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("collections")
  @@schema("tote-bag")
}

model Variant {
  id         String      @id @default(uuid()) @map("id")
  sku        String      @unique @map("sku")
  color      String      @map("color")
  imageUrl   String      @map("image_url")
  stock      Int         @default(0) @map("stock")
  productId  String      @map("product_id")
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("variants")
  @@schema("tote-bag")
}

model Order {
  id              String               @id @default(uuid()) @map("id")
  orderNumber     Int                  @unique @default(autoincrement()) @map("order_number")
  customerEmail   String               @map("customer_email")
  customerPhone   String               @map("customer_phone")
  shippingAddress Json                 @map("shipping_address")
  city            String               @map("city")
  totalAmount     Float                @map("total_amount")
  currency        String               @default("COP") @map("currency")
  status          OrderStatus          @default(PENDIENTE_PAGO) @map("status")
  trackingNumber  String?              @map("tracking_number")
  carrier         String?              @map("carrier")
  isB2B           Boolean              @default(false) @map("is_b2b")
  createdAt       DateTime             @default(now()) @map("created_at")
  profileId       String?              @map("profile_id")
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  profile         Profile?             @relation(fields: [profileId], references: [id])

  @@map("orders")
  @@schema("tote-bag")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @map("id")
  orderId   String      @map("order_id")
  status    OrderStatus @map("status")
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
  @@schema("tote-bag")
}

model OrderItem {
  id                String   @id @default(uuid()) @map("id")
  quantity          Int      @map("quantity")
  totalPrice        Float    @default(0) @map("total_price")
  sku               String   @map("sku")
  configurationJson Json?    @map("configuration_json")
  pricingJson       Json?    @map("pricing_json")
  orderId           String   @map("order_id")
  productId         String   @map("product_id")
  variantId         String?  @map("variant_id")
  unitPrice         Float    @default(0) @map("unit_price")
  order             Order    @relation(fields: [orderId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])
  variant           Variant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
  @@schema("tote-bag")
}

model User {
  id                    String                 @id @map("id")
  email                 String                 @unique @map("email")
  role                  Role                   @default(CUSTOMER) @map("role")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  auditLogs             AuditLog[]
  financialTransactions FinancialTransaction[]
  profile               Profile?
  roles                 UserRole[]

  @@map("users")
  @@schema("tote-bag")
}

model RoleModel {
  id          String           @id @default(uuid()) @map("id")
  name        String           @unique @map("name")
  description String?          @map("description")
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
  @@schema("tote-bag")
}

model Permission {
  id          String           @id @default(uuid()) @map("id")
  resource    String           @map("resource")
  action      String           @map("action")
  description String?          @map("description")
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("tote-bag")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         RoleModel  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("tote-bag")
}

model UserRole {
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String?   @map("assigned_by")
  role       RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("tote-bag")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @map("id")
  provider    String    @map("provider")
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json      @map("payload")
  processed   Boolean   @default(false) @map("processed")
  processedAt DateTime? @map("processed_at")
  error       String?   @map("error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
  @@schema("tote-bag")
}

model Profile {
  id                   String        @id @default(uuid()) @map("id")
  email                String        @unique @map("email")
  firstName            String?       @map("first_name")
  lastName             String?       @map("last_name")
  phone                String?       @map("phone")
  department           String?       @map("department")
  municipality         String?       @map("municipality")
  neighborhood         String?       @map("neighborhood")
  address              String?       @map("address")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  userId               String        @unique @map("user_id")
  metadata             Json?         @map("metadata")
  departmentId         String?       @map("department_id")
  municipalityId       String?       @map("municipality_id")
  dataPolicyAccepted   Boolean       @default(false) @map("data_policy_accepted")
  dataPolicyAcceptedAt DateTime?     @map("data_policy_accepted_at")
  dataPolicyAcceptedIp String?       @map("data_policy_accepted_ip")
  addresses            Address[]
  orders               Order[]
  locationDepartment   Department?   @relation(fields: [departmentId], references: [id])
  locationMunicipality Municipality? @relation(fields: [municipalityId], references: [id])
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
  @@schema("tote-bag")
}

model Department {
  id             String         @id @default(uuid()) @map("id")
  name           String         @unique @map("name")
  code           String?        @unique @map("code")
  addresses      Address[]
  municipalities Municipality[]
  profiles       Profile[]

  @@map("departments")
  @@schema("tote-bag")
}

model Municipality {
  id           String     @id @default(uuid()) @map("id")
  name         String     @map("name")
  code         String?    @map("code")
  departmentId String     @map("department_id")
  addresses    Address[]
  department   Department @relation(fields: [departmentId], references: [id])
  profiles     Profile[]

  @@unique([departmentId, name])
  @@map("municipalities")
  @@schema("tote-bag")
}

model B2BQuote {
  id           String         @id @default(uuid()) @map("id")
  businessName String         @map("business_name")
  quantity     Int            @map("quantity")
  department   String         @map("department")
  municipality String         @map("municipality")
  neighborhood String         @map("neighborhood")
  address      String         @map("address")
  contactPhone String         @map("contact_phone")
  qrType       String         @map("qr_type")
  qrData       String?        @map("qr_data")
  logoUrl      String?        @map("logo_url")
  package      String         @map("package")
  status       String         @default("PENDIENTE") @map("status")
  size         String?        @map("size")
  material     String?        @map("material")
  createdAt    DateTime       @default(now()) @map("created_at")
  items        B2BQuoteItem[]

  @@map("b2b_quotes")
  @@schema("tote-bag")
}

model AuditLog {
  id           String   @id @default(uuid()) @map("id")
  action       String   @map("action")
  entity       String   @map("entity")
  entityId     String?  @map("entity_id")
  payload      Json?    @map("payload")
  userId       String?  @map("user_id")
  ip           String?  @map("ip")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  previousData Json?    @map("previous_data")
  user         User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@schema("tote-bag")
}

model Address {
  id             String       @id @default(uuid()) @map("id")
  profileId      String       @map("profile_id")
  title          String       @map("title")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  phone          String       @map("phone")
  departmentId   String       @map("department_id")
  municipalityId String       @map("municipality_id")
  address        String       @map("address")
  neighborhood   String?      @map("neighborhood")
  additionalInfo String?      @map("additional_info")
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  department     Department   @relation(fields: [departmentId], references: [id])
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("addresses")
  @@schema("tote-bag")
}

model ProductAttribute {
  id            String        @id @default(uuid()) @map("id")
  productId     String        @map("product_id")
  type          AttributeType @map("type")
  priceModifier Float         @default(0) @map("price_modifier")
  isActive      Boolean       @default(true) @map("is_active")
  sortOrder     Int           @default(0) @map("sort_order")
  value         String        @default("") @map("value")
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@map("product_attributes")
  @@schema("tote-bag")
}

model PersonalizationOption {
  id                    String                @id @default(uuid()) @map("id")
  code                  String                @unique @map("code")
  name                  String                @map("name")
  description           String?               @map("description")
  basePrice             Float                 @map("base_price")
  isActive              Boolean               @default(true) @map("is_active")
  allowedMaterialValues String[]              @default([]) @map("allowed_material_values")
  rules                 PersonalizationRule[]

  @@map("personalization_options")
  @@schema("tote-bag")
}

model PersonalizationRule {
  id                    String                @id @default(uuid()) @map("id")
  productId             String                @map("product_id")
  personalizationId     String                @map("personalization_id")
  allowedSizeValues     String[]              @map("allowed_size_values")
  allowedQualityValues  String[]              @map("allowed_quality_values")
  allowedMaterialValues String[]              @map("allowed_material_values")
  extraPrice            Float                 @default(0) @map("extra_price")
  extraDays             Int                   @default(0) @map("extra_days")
  isActive              Boolean               @default(true) @map("is_active")
  personalization       PersonalizationOption @relation(fields: [personalizationId], references: [id], onDelete: Cascade)
  product               Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([personalizationId])
  @@map("personalization_rules")
  @@schema("tote-bag")
}

model PricingRule {
  id             String         @id @default(uuid()) @map("id")
  productId      String         @map("product_id")
  discountPct    Int?           @map("discount_pct")
  fixedUnitPrice Float?         @map("fixed_unit_price")
  isActive       Boolean        @default(true) @map("is_active")
  maxQty         Int?           @map("max_qty")
  minQty         Int            @default(1) @map("min_qty")
  scope          PriceRuleScope @default(B2C) @map("scope")
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, scope])
  @@map("pricing_rules")
  @@schema("tote-bag")
}

model B2BQuoteItem {
  id                String   @id @default(uuid()) @map("id")
  quoteId           String   @map("quote_id")
  productId         String   @map("product_id")
  quantity          Int      @map("quantity")
  configurationJson Json     @map("configuration_json")
  notes             String?  @map("notes")
  targetUnitPrice   Float?   @map("target_unit_price")
  product           Product  @relation(fields: [productId], references: [id])
  quote             B2BQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("b2b_quote_items")
  @@schema("tote-bag")
}

enum OrderStatus {
  PENDIENTE_PAGO
  PAGADA
  EN_PRODUCCION
  ENVIADA
  ENTREGADA
  CANCELADA

  @@schema("tote-bag")
}

enum Role {
  ADMIN
  CUSTOMER
  VIEWER
  ADVISOR

  @@schema("tote-bag")
}

enum ProductStatus {
  DISPONIBLE
  BAJO_PEDIDO
  PREVENTA

  @@schema("tote-bag")
}

enum PrintType {
  SERIGRAFIA
  DTF

  @@schema("tote-bag")
}

enum AttributeType {
  SIZE
  MATERIAL
  QUALITY
  LINE

  @@schema("tote-bag")
}

enum ProductLine {
  ECO
  COMERCIAL
  PREMIUM
  CORPORATIVA

  @@schema("tote-bag")
}

enum PriceRuleScope {
  B2C
  B2B

  @@schema("tote-bag")
}

enum WizardCategory {
  LINE
  DIMENSION
  MATERIAL
  QUALITY
  TECHNIQUE

  @@schema("tote-bag")
}

model WizardOption {
  id                 String         @id @default(uuid()) @map("id")
  category           WizardCategory @map("category")
  name               String         @map("name")
  code               String         @unique @map("code")
  description        String?        @map("description")
  basePriceModifier  Float          @default(0) @map("base_price_modifier")
  isActive           Boolean        @default(true) @map("is_active")
  sortOrder          Int            @default(0) @map("sort_order")
  allowedMaterialValues String[]    @default([]) @map("allowed_material_values")
  metadata           Json?          @map("metadata")
  imageUrl           String?        @map("image_url")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@map("wizard_options")
  @@schema("tote-bag")
}

model Supplier {
  id           String                 @id @default(uuid()) @map("id")
  name         String                 @map("name")
  nit          String                 @unique @map("nit")
  contact      String?                @map("contact")
  email        String?                @map("email")
  phone        String?                @map("phone")
  address      String?                @map("address")
  balance      Float                  @default(0) @map("balance")
  batches      PurchaseBatch[]
  transactions FinancialTransaction[]
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@map("suppliers")
  @@schema("tote-bag")
}

model PurchaseBatch {
  id                String                 @id @default(uuid()) @map("id")
  productId         String                 @map("product_id")
  supplierId        String                 @map("supplier_id")
  quantityReceived  Int                    @map("quantity_received")
  quantityRemaining Int                    @map("quantity_remaining")
  unitCost          Float                  @map("unit_cost")
  totalCost         Float                  @map("total_cost")
  status            BatchStatus            @default(IN_STOCK) @map("status")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  product           Product                @relation(fields: [productId], references: [id])
  supplier          Supplier               @relation(fields: [supplierId], references: [id])
  transactions      FinancialTransaction[]

  @@map("purchase_batches")
  @@schema("tote-bag")
}

model FinancialTransaction {
  id              String              @id @default(uuid()) @map("id")
  type            TransactionType     @map("type")
  category        TransactionCategory @map("category")
  amount          Float               @map("amount")
  description     String              @map("description")
  status          TransactionStatus   @default(COMPLETED) @map("status")
  userId          String              @map("user_id")
  purchaseBatchId String?             @map("purchase_batch_id")
  opexCategoryId  String?             @map("opex_category_id")
  supplierId      String?             @map("supplier_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  user            User                @relation(fields: [userId], references: [id])
  purchaseBatch   PurchaseBatch?      @relation(fields: [purchaseBatchId], references: [id])
  opexCategory    OpexCategory?       @relation(fields: [opexCategoryId], references: [id])
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])

  @@map("financial_transactions")
  @@schema("tote-bag")
}

model OpexCategory {
  id           String                 @id @default(uuid()) @map("id")
  name         String                 @unique @map("name")
  description  String?                @map("description")
  transactions FinancialTransaction[]
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@map("opex_categories")
  @@schema("tote-bag")
}

enum BatchStatus {
  PENDING
  IN_STOCK
  DEPLETED
  CANCELLED

  @@schema("tote-bag")
}

enum TransactionType {
  INCOME
  EXPENSE

  @@schema("tote-bag")
}

enum TransactionCategory {
  SALE
  PURCHASE
  OPEX
  PAYROLL

  @@schema("tote-bag")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@schema("tote-bag")
}
