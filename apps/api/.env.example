# App
NODE_ENV=development
PORT=4003
JSON_BODY_LIMIT=256kb
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tote_bag
# Prefer the direct/non-pooled database URL for Prisma migrations in staging
# and production. If omitted, migrate deploy falls back to DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tote_bag
POSTGRES_URL_NON_POOLING=
# Prefer inheriting the SSL mode declared in the connection string. Set to
# false only when the target database must disable SSL explicitly.
DATABASE_SSL=inherit
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SERVICE_ROLE=replace-me
JWT_SECRET=replace-me

# Redis and cache
REDIS_URL=
# When REDIS_URL is empty or Redis fails, the API falls back to in-memory cache
# and /health exposes the cache dependency as degraded.
CACHE_TTL=600000

# Wompi
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_COMMISSION_PERCENT=0
WOMPI_FIXED_FEE_COP=0
WOMPI_PACKAGING_CIF_COP=990
WOMPI_COMMISSION_VAT_PERCENT=0
WOMPI_RETEFUENTE_PERCENT=0
WOMPI_RETEIVA_PERCENT=0
WOMPI_RETEICA_PERCENT=0

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
ENABLE_SENTRY_DEBUG=false

# Metrics
METRICS_ACCESS_POLICY=public
METRICS_BEARER_TOKEN=

# Operational controls
ORDER_PENDING_EXPIRATION_HOURS=24
ORDER_EXPIRATION_CHECK_INTERVAL_MINUTES=30
WEBHOOK_RETRY_INTERVAL_MINUTES=15
WEBHOOK_RETRY_MAX_ATTEMPTS=5
